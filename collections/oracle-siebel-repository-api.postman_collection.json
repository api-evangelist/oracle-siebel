          "name": "Describe workspace repository objects",
          "request": {
            "name": "Describe workspace repository objects",
            "description": {
              "content": "Retrieve a catalog of all repository objects available in the specified workspace. Returns an OpenAPI-compatible specification listing available applets, views, business components, and other Siebel repository metadata.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "workspace",
                ":WorkspaceName",
                "describe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "main",
                  "key": "WorkspaceName",
                  "description": "(Required) Name of the Siebel workspace (use 'main' for the default workspace)"
                },
                {
                  "description": "Hostname and port of the Siebel Application Interface running the siebel-rest.war deployment on Apache Tomcat",
                  "type": "any",
                  "value": "{{siebel-server}}",
                  "key": "siebel-server"
                }
              ]
