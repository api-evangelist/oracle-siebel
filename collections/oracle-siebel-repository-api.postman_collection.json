                  "disabled": false,
                  "type": "any",
                  "value": "main",
                  "key": "WorkspaceName",
                  "description": "(Required) Name of the Siebel workspace (use 'main' for the default workspace)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "RepositoryObject",
                  "description": "(Required) Type of repository object (e.g., Applet, View, Business Component)"
