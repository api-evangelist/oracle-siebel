      "item": [
        {
          "id": "6a11fe8f-a0a1-42b0-aa11-5d400bc4fa2c",
          "name": "Invoke a business service method",
          "request": {
            "name": "Invoke a business service method",
            "description": {
              "content": "Execute a method on a named Siebel business service. The service name and method name are specified in the URL path. The request body contains the input parameters as a Siebel property set or integration object message. Business services must be explicitly configured for REST access and associated with a responsibility to control access.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "service",
                ":ServiceName",
                ":MethodName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ServiceName",
                  "description": "(Required) Name of the Siebel business service to invoke"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "MethodName",
                  "description": "(Required) Name of the method to execute on the business service"
                },
                {
                  "description": "Hostname and port of the Siebel Application Interface running the siebel-rest.war deployment on Apache Tomcat",
                  "type": "any",
                  "value": "{{siebel-server}}",
                  "key": "siebel-server"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": {\n    \"SiebelMessage\": {\n      \"MessageId\": \"<string>\",\n      \"MessageType\": \"Integration Object\",\n      \"IntObjectName\": \"<string>\",\n      \"IntObjectFormat\": \"Siebel Hierarchical\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
